# Assistant Memory — required environment variables
# Copy this file to .env and fill in your values.

# Required — identity of the memory owner
MEMORY_USER_ID=your-user-id

# Required — Neo4j database password (set when starting the Docker container)
NEO4J_PASSWORD=your-neo4j-password

# Optional — root data directory (default: ~/.memory)
# MEMORY_BASE_DIR=~/.memory

# Optional — Docker container name (default: memory-neo4j)
# NEO4J_CONTAINER_NAME=memory-neo4j

# Optional — assistant name used as ctx.assistant and the JSON section key
# MEMORY_ASSISTANT_NAME=assistant
